# Copie para .env. Docker Compose le este arquivo; Python direto usa o ambiente.
CACHE_SEGUNDOS=86400
MAXIMO_MESES_CACHE=36
# Endereco interno da API visto pelo Next durante build e execucao Docker.
API_INTERNA=http://api:8000
PORTA_WEB=3000
# Origens explícitas separadas por vírgula; nunca use * com credenciais.
ORIGENS_CORS=http://localhost:3000,http://127.0.0.1:3000
